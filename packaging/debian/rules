#!/usr/bin/make -f
# Builds the Debian package from this source tree, reusing the top-level
# Makefile's `install` target for the file list (as the RPM and Arch packages
# do). Crates are fetched from crates.io at build time (--locked pins them to
# Cargo.lock), so the build needs network; run it in the Debian podman
# container (see packaging/debian/Containerfile). --no-default-features selects
# the libadwaita 1.7 shortcuts fallback, since Debian stable has no
# AdwShortcutsDialog.
#
# The cargo cache and build tree live under debian/ (CARGO_HOME,
# CARGO_TARGET_DIR), which `make deb` stages and removes. This keeps the deb
# build from touching target/ at all, so it neither overwrites a local
# target/release build nor deletes sibling artifacts such as target/rpm.

export CARGO_HOME = $(CURDIR)/debian/cargo
export CARGO_TARGET_DIR = $(CURDIR)/debian/target

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked --no-default-features

override_dh_auto_test:
	cargo test --release --locked --no-default-features

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/whatsup-desktop PREFIX=/usr \
	    BINARY=$(CURDIR)/debian/target/release/whatsup-desktop

override_dh_auto_clean:
	rm -rf debian/target debian/cargo
